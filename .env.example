# Database (Supabase PostgreSQL)
# Use Session Pooler from Supabase Dashboard → Settings → Database → Connection pooling
# Host format: aws-X-us-east-1.pooler.supabase.com (NOT db.project-id.supabase.co)
DATABASE_URL="postgresql://postgres.klruigddjntsrgfsgnen:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# Supabase Public Keys (safe for client-side)
# Get these from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[project-id].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"

# API Keys
# ANTHROPIC_API_KEY=your_key_here

# JWT Secret
JWT_SECRET=your_secret_key_here

# Node Environment
NODE_ENV=production
